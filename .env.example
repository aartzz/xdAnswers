# Firefox Add-ons API credentials
# Get yours at https://addons.mozilla.org/developers/addon/api/key/
#
# NEVER commit this file with real values — .env is gitignored.
# Copy this example:  cp .env.example .env   then fill in your keys.

WEB_EXT_API_KEY=
WEB_EXT_API_SECRET=

# Chrome CRX signing key: PEM contents or path to a .pem file.
# Keep empty for local builds to auto-generate build/chrome-extension.pem.
CHROME_EXTENSION_KEY=
