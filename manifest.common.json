{
  "manifest_version": 3,
  "name": "xdAnswers",
  "version": "5.6.1",
  "description": "AI-powered answers for educational tests.",
  "permissions": [
    "storage",
    "clipboardWrite",
    "tabs",
    "webNavigation",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/core/disabler.ts",
        "src/providers/naurok/round/reorder-page.ts",
        "lib/beercss/material-symbols-outlined.woff2"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "xd-trigger-answer": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "xdAnswers: trigger answer for current question"
    }
  },
  "action": {
    "default_title": "xdAnswers Settings",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    },
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://vseosvita.ua/test/go-olp*",
